{
	"name": "lernassi",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env scripts/migrate.mjs",
		"db:fixture": "node --env-file=.env scripts/fixture-export.mjs",
		"db:seed": "node --env-file=.env scripts/seed.mjs",
		"health:requesty": "node --env-file=.env scripts/health-requesty.mjs",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.16",
		"@fontsource-variable/source-sans-3": "^5.3.0",
		"@fontsource/quicksand": "^5.3.0",
		"ai": "^7.0.40",
		"better-auth": "^1.6.25",
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	}
}
