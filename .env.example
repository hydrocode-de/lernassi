# Lokale SQLite-Datei. Später Postgres-URL.
DATABASE_URL=./local.db

# Better Auth — geheimes Signing-Secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Requesty (EU) — Vision-Modell für das Lesen der Aufschriebe
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1
REQUESTY_MODEL=anthropic/claude-sonnet-4-5

# Einmalcode für Lehrkraft-Konten. Ohne ihn legt niemand ein Lehrkraft-Konto an —
# wer ein Konto anlegen kann, sieht die Aufschriebe von Kindern. Leer heißt: gesperrt.
TEACHER_SIGNUP_CODE=

# Ablage der Seitenbilder (nur wenn erlaubt; im Echt-Betrieb standardmäßig nicht gespeichert)
UPLOAD_DIR=./data/uploads
