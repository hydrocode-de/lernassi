# Lokale SQLite-Datei. Später Postgres-URL.
DATABASE_URL=./local.db

# Better Auth — geheimes Signing-Secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Requesty (EU) — Vision-Modell für das Lesen der Aufschriebe
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1
REQUESTY_MODEL=anthropic/claude-sonnet-4-5

# Übung im Gespräch (M5, in Erprobung). Ohne `1` gibt es nur die klassische Übung —
# der Knopf im Lernplan erscheint gar nicht erst. Siehe GESPRAECH.md.
GESPRAECH=
# Eigenes Modell für den Gesprächs-Agenten. Er wird je Zug gerufen, also ein Vielfaches
# so oft wie die anderen — hier lohnt das Tauschen zuerst. Leer = REQUESTY_MODEL.
REQUESTY_MODEL_GESPRAECH=

# Nachlesen (Recherche, in Erprobung). Ohne `1` gibt es den Knopf nirgends und die Lehrkraft
# sieht die Einstellung nicht. Darin entscheidet die Klasse — Standard ist auch dann: aus.
RECHERCHE=
# Kennung für die Wiki-APIs. Wikimedia verlangt eine sprechende Angabe mit Kontaktadresse;
# ohne eigene Angabe läuft es unter einer Platzhalter-Adresse.
RECHERCHE_USER_AGENT=

# Einmalcode für Lehrkraft-Konten. Ohne ihn legt niemand ein Lehrkraft-Konto an —
# wer ein Konto anlegen kann, sieht die Aufschriebe von Kindern. Leer heißt: gesperrt.
TEACHER_SIGNUP_CODE=

# Ablage der Seitenbilder (nur wenn erlaubt; im Echt-Betrieb standardmäßig nicht gespeichert)
UPLOAD_DIR=./data/uploads

# --- Nur auf dem Server, nur für die Dev-Instanz ---------------------------------
# Ohne diese drei Werte fährt docker-compose.yml die Produktion (Port 8030,
# lernassi.hydrocode.cloud, /data/lernassi). Der zweite Checkout in /apps/lernassi-dev
# überschreibt sie hier. Lokal beim Entwickeln braucht sie niemand — siehe DEPLOY.md.
#
# LERNASSI_PORT=8032
# LERNASSI_ORIGIN=https://dev.lernassi.hydrocode.cloud
# LERNASSI_DATEN=/data/lernassi-dev
#
# Die Dev-Instanz liefert ein eigenes Zeichen für die PWA aus — dasselbe wie sonst, mit
# einer „staging"-Binde. Erkannt wird sie an LERNASSI_ORIGIN (`dev.…`), hier ist also
# nichts zu setzen. Nur falls die Dev-Instanz einmal anders heißt:
# LERNASSI_UMGEBUNG=staging
